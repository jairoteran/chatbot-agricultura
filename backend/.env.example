APP_DEPLOYMENT_TARGET=local

# Local or future cloud-oriented backends
DOCUMENT_STORAGE_BACKEND=local
INDEX_STORAGE_BACKEND=local
METADATA_BACKEND=none
PROCESS_STATE_BACKEND=none

# Local development paths
LOCAL_DATA_DIR=
LOCAL_STORAGE_DIR=
CLOUD_INDEX_CACHE_DIR=

# Cloud resource naming
GOOGLE_CLOUD_PROJECT=tesis-producto-dev
GOOGLE_CLOUD_REGION=us-central1
DOCUMENTS_BUCKET=tesis-producto-dev-documents
DOCUMENTS_PREFIX=documents
INDEXES_BUCKET=tesis-producto-dev-indexes
INDEXES_PREFIX=indexes
ACTIVE_INDEX_NAME=current
FIRESTORE_DOCUMENTS_COLLECTION=documents
FIRESTORE_JOBS_COLLECTION=reindex_jobs
FIRESTORE_RUNTIME_COLLECTION=runtime_state

# Models and behavior
ALLOW_RUNTIME_REINDEX=true
ENABLE_VECTOR_RETRIEVAL=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=2.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Networking
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin access
GOOGLE_AUTH_CLIENT_ID=
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_BASE_PATH=/gestion
