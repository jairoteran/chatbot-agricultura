# Para desarrollo local con el proxy de Vite:
# VITE_API_URL=/api/chat
# VITE_HEALTH_URL=/api/health
# VITE_REINDEX_URL=/api/reindex
# VITE_SUMMARY_URL=/api/summarize-document

# Para GitHub Pages usa la URL completa de tu backend desplegado:
VITE_API_URL=https://tu-backend.onrender.com/chat
VITE_HEALTH_URL=https://tu-backend.onrender.com/health
VITE_REINDEX_URL=https://tu-backend.onrender.com/reindex
VITE_SUMMARY_URL=https://tu-backend.onrender.com/summarize-document

# Base del sitio cuando se publica en GitHub Pages:
VITE_BASE_PATH=/chatbot-agricultura/
