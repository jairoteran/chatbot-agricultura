# Para desarrollo local con el proxy de Vite:
# VITE_API_URL=/api/chat
# VITE_HEALTH_URL=/api/health
# VITE_REINDEX_URL=/api/reindex
# VITE_SUMMARY_URL=/api/summarize-document

# Si frontend y backend viven detras del mismo dominio con rewrite, puedes usar rutas relativas:
# VITE_API_URL=/api/chat
# VITE_HEALTH_URL=/api/health
# VITE_REINDEX_URL=/api/reindex
# VITE_SUMMARY_URL=/api/summarize-document
# VITE_ADMIN_CONFIG_URL=/api/admin/config
# VITE_ADMIN_SESSION_URL=/api/admin/session
# VITE_ADMIN_DOCUMENTS_URL=/api/admin/documents
# VITE_ADMIN_BASE_PATH=/gestion

# Si publicas el frontend en Cloud Run u otro hosting separado, usa la URL completa del backend:
VITE_API_URL=https://tesis-producto-api-1025954944056.us-central1.run.app/chat
VITE_HEALTH_URL=https://tesis-producto-api-1025954944056.us-central1.run.app/health
VITE_REINDEX_URL=https://tesis-producto-api-1025954944056.us-central1.run.app/reindex
VITE_SUMMARY_URL=https://tesis-producto-api-1025954944056.us-central1.run.app/summarize-document
VITE_ADMIN_CONFIG_URL=https://tesis-producto-api-1025954944056.us-central1.run.app/admin/config
VITE_ADMIN_SESSION_URL=https://tesis-producto-api-1025954944056.us-central1.run.app/admin/session
VITE_ADMIN_DOCUMENTS_URL=https://tesis-producto-api-1025954944056.us-central1.run.app/admin/documents
VITE_ADMIN_BASE_PATH=/gestion

# Base del sitio cuando se publica bajo un subpath:
# VITE_BASE_PATH=/mi-subruta/
